[Unit]
Description=sepordi.ir web (Next.js standalone)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/sepordi/current/server.js

[Service]
User=sepordi
Group=sepordi
WorkingDirectory=/opt/sepordi/current
EnvironmentFile=/etc/sepordi/env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 SEPORDI_DB_PATH=/var/lib/sepordi/sepordi.db
ExecStart=/opt/node/bin/node server.js
Restart=always
RestartSec=3
# Node exits 143 on the SIGTERM of a normal stop.
SuccessExitStatus=143
MemoryMax=700M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Next writes its prerender/route cache under the release's .next/server.
ReadWritePaths=/var/lib/sepordi /opt/sepordi/releases
PrivateTmp=true

[Install]
WantedBy=multi-user.target
