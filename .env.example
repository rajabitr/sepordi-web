# Copy to .env.local (development) or the server's environment. Names only; never commit values.

# Bizin Partner API (server-side only; the key opens every shop of the partner)
BIZIN_API_BASE=https://api.bizin.app/partner/v1
BIZIN_PARTNER_KEY=
# "mock" = in-memory fake Bizin with demo data; anything else = the real API (needs BIZIN_PARTNER_KEY)
BIZIN_MODE=
# Comma-separated whsec_… secrets, newest first during a rotation
BIZIN_WEBHOOK_SECRETS=

# SQLite file (default ./data/sepordi.db)
SEPORDI_DB_PATH=
# Keys the OTP code hashes; any long random string
SESSION_SECRET=

# Kavenegar Verify Lookup (OTP). Without both, production login is mobile + password.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

ZARINPAL_MERCHANT_ID=
# Public origin, e.g. https://sepordi.ir (metadata, Instagram connect return_url)
PUBLIC_BASE_URL=
